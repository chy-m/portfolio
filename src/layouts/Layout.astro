---
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Yo, yo! Come check out another dev portfolio site, and an internal monologue by Chy Meng"
    />
    <meta name="theme-color" content="#FFA3AC" />
    <title>{title}</title>
    <!-- initialize theme -->
    <script is:inline>
      const root = document.documentElement;
      const colorScheme = window.matchMedia("(prefers-color-scheme: dark)");
      let savedTheme;

      try {
        savedTheme = localStorage.getItem("theme");
      } catch {
        // Theme selection must also work when browser storage is unavailable.
      }

      if (savedTheme === "light" || savedTheme === "dark") {
        root.dataset.themePreference = savedTheme;
      }

      root.dataset.theme = root.dataset.themePreference ||
        (colorScheme.matches ? "dark" : "light");

      colorScheme.addEventListener("change", (event) => {
        if (root.dataset.themePreference) return;

        root.dataset.theme = event.matches ? "dark" : "light";
        document.querySelector(".toggle-theme-switch")?.setAttribute(
          "aria-pressed", String(event.matches)
        );
      });
    </script>
  </head>
  <body
    class="h-screen max-w-5xl mx-auto p-5 md:p-10 relative bg-white dark:bg-lightBlack dark:text-white"
  >
    <div class="h-full relative">
      <ThemeToggle />
      <slot />
    </div>
  </body>
</html>
<style is:global>
  @import url("https://fonts.cdnfonts.com/css/circular-std?styles=17911,17907,17905");
  html {
    font-family: "CircularStd", system-ui, sans-serif;
  }
  code {
    font-family: Menlo, Monaco, Lucida Console, Liberation Mono,
      DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace;
  }
</style>
