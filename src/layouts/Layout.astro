---
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Yo, yo! Come check out another dev portfolio site, and an internal monologue by Chy Meng"
    />
    <meta name="theme-color" content="#FFA3AC" />
    <title>{title}</title>
    <!-- initialize theme -->
    <script is:inline>
      const root = document.documentElement;
      const colorScheme = window.matchMedia("(prefers-color-scheme: dark)");
      let savedTheme;

      try {
        savedTheme = localStorage.getItem("theme");
      } catch {
        // Theme selection must also work when browser storage is unavailable.
      }

      if (savedTheme === "light" || savedTheme === "dark") {
        root.dataset.themePreference = savedTheme;
      }

      root.dataset.theme = root.dataset.themePreference ||
        (colorScheme.matches ? "dark" : "light");

      colorScheme.addEventListener("change", (event) => {
        if (root.dataset.themePreference) return;

        root.dataset.theme = event.matches ? "dark" : "light";
        document.querySelector(".toggle-theme-switch")?.setAttribute(
          "aria-pressed", String(event.matches)
        );
      });
    </script>
  </head>
  <body>
    <div class="site-content">
      <ThemeToggle />
      <slot />
    </div>
  </body>
</html>
