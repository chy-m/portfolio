---
import SunRay from "../components/SunRay.astro";
import "../styles/theme-toggle.css";
---

<button
  type="button"
  aria-label="Dark mode"
  aria-pressed="false"
  class="toggle-theme-switch"
>
  <span
    class="moon"
  ></span>
  <span class="sun"></span>
  <SunRay />
  <SunRay />
  <SunRay />
  <SunRay />
  <SunRay />
  <SunRay />
</button>

<script>
  import { togglePreference } from "../../lib/theme-util";

  const toggle = document.querySelector(".toggle-theme-switch");
  toggle?.setAttribute(
    "aria-pressed", String(document.documentElement.dataset.theme === "dark")
  );
  toggle?.addEventListener("click", togglePreference);
</script>
