---
import { Image } from 'astro:assets';
import avatar from "../assets/avatar.webp";
---

<div class="flex flex-wrap items-center mb-8">
  <h1
    class="text-2xl md:text-5xl font-extrabold leading-tight mr-7 transition ease-in"
  >
    <span class="wave">👋</span> Hello, <span class="name-hl whitespace-nowrap px-2.5 rounded-lg">
      I'm Chy.</span
    >
  </h1>
  <Image
    src={avatar}
    format="webp"
    width={112}
    height={112}
    densities={[1, 2]}
    quality={75}
    loading="eager"
    alt="chy avatar"
    class="avatar w-28 rounded-full transition ease-in"
  />
</div>
