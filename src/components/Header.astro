---
import { Image } from 'astro:assets';
import avatar from "../assets/avatar.webp";
---

<div class="intro">
  <h1 class="intro-heading">
    <span class="wave">👋</span> Hello, <span class="name-hl">
      I'm Chy.</span
    >
  </h1>
  <Image
    src={avatar}
    format="webp"
    width={112}
    height={112}
    densities={[1, 2]}
    quality={75}
    loading="eager"
    alt="chy avatar"
    class="avatar"
  />
</div>
